rules_version = '2';
// Chronos (docs/SYNC.md). One user's data lives at users/{uid}/{collection}/{docId}.
// Only that signed-in user may read or write it. Clients never hard-delete
// (deletes are tombstones). A trusted server using the Admin SDK (Phase 4 remote
// MCP) bypasses these rules by design, so it needs no rule change.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{collection}/{docId} {
      function owner() {
        return request.auth != null && request.auth.uid == uid;
      }
      function known() {
        return collection in ['tasks', 'events', 'eventExceptions', 'closures', 'blocks', 'sessions', 'tags', 'ideas', 'activity', 'timer', 'settings', 'projects', 'reviews'];
      }
      function valid() {
        let d = request.resource.data;
        return d.id == docId
          && d.v is int && d.v >= 1
          && d.serverUpdatedAt == request.time
          && (!('fv' in d) || d.fv is map)
          && (!('fw' in d) || d.fw is map)
          && d.size() < 80;
      }
      // Schema v3 fields (docs/SYNC.md). Absent fields pass (documents written by v2 devices);
      // the app's own validators are the real gate, these keep a bad client from storing junk.
      function shape() {
        let d = request.resource.data;
        return (collection != 'events'
            || ((!('durationMin' in d) || (d.durationMin is int && d.durationMin >= 1 && d.durationMin <= 1440))
              && (d.get('startMin', null) == null) == (d.get('endMin', null) == null)))
          && (collection != 'ideas' || d.get('projectId', null) == null || d.projectId is string)
          && (collection != 'blocks' || !('auto' in d) || d.auto is bool)
          && (collection != 'settings'
            || ((!('themeSchedule' in d) || (d.themeSchedule is list && d.themeSchedule.size() <= 24))
              && (!('weeklyFocusTargetH' in d) || (d.weeklyFocusTargetH is number && d.weeklyFocusTargetH >= 0 && d.weeklyFocusTargetH <= 168))
              && (!('sound' in d) || d.sound is map)
              && (!('energy' in d) || d.energy is map)
              && (!('widgets' in d) || d.widgets is map)
              && (!('planning' in d) || d.planning is map)
              && (!('parserReports' in d) || (d.parserReports is list && d.parserReports.size() <= 200))));
      }
      allow read: if owner() && known();
      allow create, update: if owner() && known() && valid() && shape();
      allow delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
