{
  "$schema": "chronos-theme/1",
  "id": "stark-workshop",
  "name": "Stark workshop",
  "mode": "dark",
  "fonts": {
    "display": {
      "family": "Chakra Petch",
      "weights": [
        500,
        600
      ],
      "source": "fontsource"
    },
    "text": {
      "family": "Sora",
      "weights": [
        300,
        400,
        500
      ],
      "source": "fontsource"
    },
    "numerals": "display",
    "tabularNumbers": true
  },
  "color": {
    "ground": "#03060B",
    "groundLight": "rgba(79,216,255,0.13)",
    "panel": "rgba(5,12,20,0.75)",
    "panelHero": "rgba(79,216,255,0.07)",
    "line": "rgba(79,216,255,0.20)",
    "lineStrong": "rgba(79,216,255,0.40)",
    "text": "#F2FBFF",
    "text2": "#CFE9F5",
    "text3": "#9FC3D4",
    "muted": "#7FA3B5",
    "accent": "#4FD8FF",
    "accentHover": "#A6ECFF",
    "onAccent": "#03060B",
    "now": "#FFB547",
    "wellness": "#FFB547",
    "ok": "#5BE3A4",
    "warn": "#FFB547",
    "danger": "#FF5A6A",
    "fixedBlock": "#5F7D8E",
    "selection": "#4FD8FF"
  },
  "shape": {
    "radiusSm": 10,
    "radiusMd": 14,
    "radiusLg": 18,
    "pill": 999
  },
  "depth": {
    "float": "0 18px 40px rgba(0,0,0,0.45)"
  },
  "motion": {
    "ease": "cubic-bezier(.16,1,.3,1)",
    "fast": 160,
    "base": 420,
    "signature": {
      "kind": "reactor-ring",
      "segments": 40,
      "chargeMs": 1400,
      "tickRotationSec": 120,
      "respectReducedMotion": true,
      "plasma": {
        "bandRotationSec": 6,
        "coreBreathSec": 3.2,
        "brightnessFollowsProgress": true
      },
      "completionFlareMs": 900
    }
  },
  "focus": {
    "widgetOpacity": 0.18,
    "widgetBlurPx": 1.5
  },
  "widgets": {
    "day": {
      "style": "dial"
    },
    "momentum": {
      "style": "week-bars"
    },
    "notes": {
      "style": "latest-two"
    },
    "wellness": {
      "style": "card",
      "breakAfterMin": 75
    }
  },
  "energy": {
    "livingReactor": true,
    "holographicDepth": {
      "enabled": true,
      "maxTiltDeg": 9,
      "assembleOnOpen": true
    },
    "reactiveData": {
      "momentumCell": true,
      "dayDialFill": true,
      "streakIgnitionDays": 5
    }
  },
  "sound": {
    "enabled": true,
    "volume": 0.35,
    "muteInFocus": false,
    "cues": {
      "blockStart": "soft-rise",
      "blockFinish": "chord"
    }
  }
}