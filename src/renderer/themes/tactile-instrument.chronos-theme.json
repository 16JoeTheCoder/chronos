{
  "$schema": "chronos-theme/1",
  "id": "tactile-instrument",
  "name": "Tactile instrument",
  "mode": "light",
  "fonts": {
    "display": {
      "family": "Hanken Grotesk",
      "weights": [
        600,
        700
      ],
      "source": "fontsource"
    },
    "text": {
      "family": "Hanken Grotesk",
      "weights": [
        400,
        600
      ],
      "source": "fontsource"
    },
    "numerals": {
      "family": "Martian Mono",
      "weights": [
        400,
        500
      ],
      "source": "fontsource",
      "generic": "monospace"
    },
    "tabularNumbers": true
  },
  "color": {
    "ground": "#DFE1E4",
    "panel": "#F2F3F5",
    "panelHero": "#F2F3F5",
    "line": "rgba(21,23,26,0.14)",
    "lineStrong": "rgba(21,23,26,0.40)",
    "text": "#15171A",
    "text2": "#5B6068",
    "text3": "#5B6068",
    "muted": "#5B6068",
    "accent": "#15171A",
    "accentHover": "#2A2D33",
    "onAccent": "#FFFFFF",
    "now": "#15171A",
    "wellness": "#8A5A00",
    "ok": "#1E7A4F",
    "warn": "#8A5A00",
    "danger": "#B3261E",
    "fixedBlock": "#767B82",
    "selection": "#15171A",
    "raised": "#F9FAFB",
    "edge": "#A9ACB1",
    "ink": "#15171A",
    "onInk": "#FFFFFF"
  },
  "shape": {
    "radiusSm": 10,
    "radiusMd": 12,
    "radiusLg": 20,
    "pill": 999
  },
  "depth": {
    "float": "0 12px 28px rgba(20,22,26,0.18)",
    "raised": "0 2px 0 #A9ACB1, 0 3px 6px rgba(20,22,26,0.12)",
    "pressed": "0 0 0 #A9ACB1, 0 1px 2px rgba(20,22,26,0.12)"
  },
  "motion": {
    "ease": "cubic-bezier(.2,0,0,1)",
    "fast": 90,
    "base": 160,
    "signature": {
      "kind": "ticking-digits",
      "tickMs": 160,
      "liftPx": 4,
      "respectReducedMotion": true
    }
  },
  "focus": {
    "widgetOpacity": 0.35,
    "widgetBlurPx": 1
  },
  "widgets": {
    "day": {
      "style": "dial"
    },
    "momentum": {
      "style": "week-bars"
    },
    "notes": {
      "style": "latest-two"
    },
    "wellness": {
      "style": "card",
      "breakAfterMin": 75
    }
  },
  "sound": {
    "enabled": true,
    "volume": 0.3,
    "muteInFocus": false,
    "cues": {
      "blockStart": "soft-rise",
      "blockFinish": "chord"
    }
  }
}