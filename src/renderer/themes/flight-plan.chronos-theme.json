{
  "$schema": "chronos-theme/1",
  "id": "flight-plan",
  "name": "Flight plan",
  "mode": "light",
  "fonts": {
    "display": {
      "family": "Barlow Condensed",
      "weights": [
        600,
        700
      ],
      "source": "fontsource"
    },
    "text": {
      "family": "Barlow",
      "weights": [
        400,
        500,
        600
      ],
      "source": "fontsource"
    },
    "numerals": {
      "family": "Courier Prime",
      "weights": [
        400,
        700
      ],
      "source": "fontsource",
      "generic": "monospace"
    },
    "tabularNumbers": true
  },
  "color": {
    "ground": "#F2F2EE",
    "panel": "#FFFFFF",
    "panelHero": "#FFFFFF",
    "line": "#D5D6D2",
    "lineStrong": "#8C9097",
    "text": "#111418",
    "text2": "#3A3F46",
    "text3": "#5A6068",
    "muted": "#5A6068",
    "accent": "#C2410C",
    "accentHover": "#B84508",
    "onAccent": "#FFFFFF",
    "now": "#D2500B",
    "wellness": "#1F3F75",
    "ok": "#17784B",
    "warn": "#B84508",
    "danger": "#B3261E",
    "fixedBlock": "#5A6068",
    "selection": "#FF6A13",
    "ink": "#111418",
    "onInk": "#FFFFFF",
    "rest": "#1F3F75",
    "raised": "#FFFFFF",
    "edge": "#8C9097",
    "pill": "#FFFFFF",
    "pillText": "#111418",
    "pillLine": "#111418",
    "scrim": "rgba(17,20,24,0.34)"
  },
  "shape": {
    "radiusSm": 4,
    "radiusMd": 6,
    "radiusLg": 8,
    "pill": 999
  },
  "depth": {
    "float": "0 12px 28px rgba(17,20,24,0.16)"
  },
  "motion": {
    "ease": "cubic-bezier(.16,1,.3,1)",
    "fast": 120,
    "base": 200,
    "signature": {
      "kind": "mission-clock",
      "respectReducedMotion": true
    }
  },
  "focus": {
    "widgetOpacity": 0.35,
    "widgetBlurPx": 1
  },
  "widgets": {
    "day": {
      "style": "dial"
    },
    "momentum": {
      "style": "week-bars"
    },
    "notes": {
      "style": "latest-two"
    },
    "wellness": {
      "style": "card",
      "breakAfterMin": 75
    }
  },
  "sound": {
    "enabled": true,
    "volume": 0.3,
    "muteInFocus": false,
    "cues": {
      "blockStart": "soft-rise",
      "blockFinish": "chord"
    }
  }
}