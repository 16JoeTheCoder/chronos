{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chronos-web",
  "main": "worker/index.ts",
  "compatibility_date": "2025-06-01",
  "workers_dev": true,
  "observability": { "enabled": true },
  "routes": [{ "pattern": "chronos.josefyang.com", "custom_domain": true }],
  "assets": {
    "directory": "./dist-web",
    "binding": "ASSETS",
    // Only /api/* runs the Worker; every other path is served from the assets (SPA fallback to index.html).
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "FIREBASE_PROJECT_ID": "chronos-jy"
  }
}
